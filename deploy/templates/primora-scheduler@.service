# Runs Laravel's scheduler once (started every minute by primora-scheduler@.timer).
[Unit]
Description=Primora scheduler (%i)
After=network.target mariadb.service

[Service]
Type=oneshot
User=primora-%i
Group=primora-%i
# No WorkingDirectory: systemd changes into it before starting PHP, and SELinux
# doesn't let systemd (init_t) read the web-labelled "current" link. Artisan
# finds the app from its own path, so it doesn't need one.
ExecStart=/usr/bin/php /var/www/primora/%i/current/artisan schedule:run --no-interaction
UMask=0027
