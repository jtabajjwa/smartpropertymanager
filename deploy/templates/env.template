# Primora — {{ENV}} ({{DOMAIN}})
# Written by `primora deploy` on first install. Edit with: sudo primora env {{ENV}}
# (which re-caches the config and restarts workers when you save).

APP_NAME=Primora
APP_ENV={{ENV}}
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://{{DOMAIN}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL={{LOG_LEVEL}}

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_NAME}}
DB_USERNAME={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=primora_{{ENV}}_

# Email stays in the log until SMTP details are filled in (then set MAIL_MAILER=smtp).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@primoraproptech.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# SMS (Marz). Off until the API key and secret are filled in.
MARZ_SMS_ENABLED=false
MARZ_SMS_API_KEY=
MARZ_SMS_API_SECRET=
MARZ_SMS_BASE_URL=https://sms.wearemarz.com/api/v1

# Shared key the marketing website uses to read published plans (/api/website/plans).
# Put the same value in website/config.local.php on the website host.
WEBSITE_API_KEY={{WEBSITE_API_KEY}}

# Mobile money (Yo! Payments). YO_MODE: sandbox | production
PAYMENTS_GATEWAY=yo
YO_API_USERNAME=
YO_API_PASSWORD=
YO_MODE={{YO_MODE}}
YO_PROVIDER_REFERENCE_TEXT="Primora PropTech"

# Private key for signing Yo! withdrawals (landlord payouts). Keep it outside the
# web root, e.g. /etc/primora/keys/{{ENV}}-yo.pem (owner root, group {{APP_USER}}, mode 640).
YO_PRIVATE_KEY_PATH=
YO_PRIVATE_KEY_PASSPHRASE=
