# Primora queue worker for one environment (%i = staging | production).
[Unit]
Description=Primora queue worker (%i)
After=network.target mariadb.service

[Service]
User=primora-%i
Group=primora-%i
# No WorkingDirectory: systemd changes into it before starting PHP, and SELinux
# doesn't let systemd (init_t) read the web-labelled "current" link. Artisan
# finds the app from its own path, so it doesn't need one.
ExecStart=/usr/bin/php /var/www/primora/%i/current/artisan queue:work --sleep=3 --tries=3 --max-time=3600 --memory=256
Restart=always
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
