APP_NAME=Primora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prime
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MARZ_SMS_ENABLED=false
MARZ_SMS_API_KEY=
MARZ_SMS_API_SECRET=
MARZ_SMS_BASE_URL=https://sms.wearemarz.com/api/v1

# Shared key the marketing website uses to read published plans (/api/website/plans).
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
WEBSITE_API_KEY=

# --- Tenant WhatsApp bot (Meta WhatsApp Cloud API; see deploy/WHATSAPP.md) ---
# Without a token and phone number id, bot replies are only logged.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret: checks that webhook calls really come from Meta
WHATSAPP_APP_SECRET=
# Any long random string; enter the same one in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# --- Mobile money collections (config/payments.php) ---
# Gateway for new payments: "yo" (Yo! Payments) or, on a dev machine only, "fake"
PAYMENTS_GATEWAY=yo
# Yo! Payments API credentials (Yo! web account → API settings) and mode: sandbox | production
YO_API_USERNAME=
YO_API_PASSWORD=
YO_MODE=sandbox
# Shown in the mobile money confirmation SMS the payer receives
YO_PROVIDER_REFERENCE_TEXT="Primora PropTech"

# Primora private key for signing Yo! withdrawals (landlord payouts); see README
YO_PRIVATE_KEY_PATH=
